# GCP deployment target for server/deploy/update.sh
# Copy this file to .env.gcp at the repo root and fill in your values.
# The real .env.gcp is gitignored and must not be committed.
PROJECT=my-gcp-project-id
INSTANCE=my-vm-instance-name
ZONE=us-central1-a
# Optional overrides (defaults shown):
# BRANCH=main
# REPO_DIR=/opt/dot-country-embedder
# SERVICE=ews
